{
  "version": 1,
  "nodes": [
    {
      "id": "input",
      "type": "tool.input",
      "fields": [
        {
          "name": "saga_id",
          "type": "string",
          "required": true,
          "description": "GutSaga saga UUID from list_sagas / create_saga / get_saga."
        },
        {
          "name": "title",
          "type": "string",
          "required": false,
          "description": "New title (omit to leave unchanged)."
        },
        {
          "name": "description",
          "type": "string",
          "required": false,
          "description": "New flavour text."
        },
        {
          "name": "objectives",
          "type": "array",
          "required": false,
          "description": "Full replacement step list (same contract as create_saga). Always send the complete list. Types: go, talk, item, kill, emote, sequence. memory visit|hold (go defaults visit, item defaults hold; talk/emote/kill/sequence are visit). sequence is one step with within_sec and 2-6 beats. A together-kill puts group {level, instance, optional size} on that kill: level is exact for every member. Do not use all_of, any_of, or objectives_ordered."
        },
        {
          "name": "changes",
          "type": "array",
          "required": true,
          "description": "What changed, one short line per item. Required. Bumps the saga version and is posted to the group webhook."
        },
        {
          "name": "min_level",
          "type": "number",
          "required": false,
          "description": "New minimum level. Text-field patches bump saga version."
        },
        {
          "name": "party",
          "type": "boolean",
          "required": false
        },
        {
          "name": "assigned_character_ids",
          "type": "array",
          "required": false,
          "description": "Full replacement assigned character UUID list."
        },
        {
          "name": "objectives_ordered",
          "type": "boolean",
          "required": false,
          "description": "Leave false. Timed order is a sequence step."
        },
        {
          "name": "active",
          "type": "boolean",
          "required": false,
          "description": "false retires the saga (hides from new takers)."
        },
        {
          "name": "image",
          "type": "file",
          "required": false,
          "description": "Optional new cover image (PNG/JPEG/WebP/GIF, max 8 MiB). Can be sent alone to only update the cover. Phase 1: { filename, content_type, confirm_sandbox: true }. Phase 2 after PUT: { file_ref }."
        }
      ]
    },
    {
      "id": "ctx",
      "type": "context.run"
    },
    {
      "id": "url",
      "type": "util.string.template",
      "config": {
        "template": "{{env.GUTSAGA_API_URL}}/v1/admin/sagas/{{id}}"
      }
    },
    {
      "id": "body",
      "type": "util.json.build",
      "config": {
        "inputs": [
          "title",
          "description",
          "objectives",
          "changes",
          "min_level",
          "party",
          "assigned_character_ids",
          "objectives_ordered",
          "active",
          "editor_email"
        ],
        "template": "{\"title\": {{title}}, \"description\": {{description}}, \"objectives\": {{objectives}}, \"changes\": {{changes}}, \"min_level\": {{min_level}}, \"party\": {{party}}, \"assigned_character_ids\": {{assigned_character_ids}}, \"objectives_ordered\": {{objectives_ordered}}, \"active\": {{active}}, \"editor_email\": {{editor_email}}}"
      }
    },
    {
      "id": "patch",
      "type": "http.request",
      "config": {
        "method": "PATCH",
        "headers": {
          "Authorization": "Bearer {{env.GUTSAGA_ADMIN_TOKEN}}"
        },
        "file_mode": "multipart",
        "file_field": "image"
      }
    },
    {
      "id": "output",
      "type": "tool.output",
      "fields": [
        {
          "name": "saga",
          "type": "object",
          "required": true,
          "description": "Updated saga. Text changes bump version; cover-only updates do not. Only sagas owned by the Smia caller (player email from companion login) can be edited."
        }
      ]
    }
  ],
  "edges": [
    {
      "id": "e1",
      "source": "input",
      "target": "url",
      "sourceHandle": "saga_id",
      "targetHandle": "id"
    },
    {
      "id": "e2",
      "source": "input",
      "target": "body",
      "sourceHandle": "title",
      "targetHandle": "title"
    },
    {
      "id": "e3",
      "source": "input",
      "target": "body",
      "sourceHandle": "description",
      "targetHandle": "description"
    },
    {
      "id": "e4",
      "source": "input",
      "target": "body",
      "sourceHandle": "objectives",
      "targetHandle": "objectives"
    },
    {
      "id": "e5",
      "source": "input",
      "target": "body",
      "sourceHandle": "changes",
      "targetHandle": "changes"
    },
    {
      "id": "e6",
      "source": "input",
      "target": "body",
      "sourceHandle": "min_level",
      "targetHandle": "min_level"
    },
    {
      "id": "e7",
      "source": "input",
      "target": "body",
      "sourceHandle": "party",
      "targetHandle": "party"
    },
    {
      "id": "e8",
      "source": "input",
      "target": "body",
      "sourceHandle": "assigned_character_ids",
      "targetHandle": "assigned_character_ids"
    },
    {
      "id": "e9",
      "source": "input",
      "target": "body",
      "sourceHandle": "objectives_ordered",
      "targetHandle": "objectives_ordered"
    },
    {
      "id": "e10",
      "source": "input",
      "target": "body",
      "sourceHandle": "active",
      "targetHandle": "active"
    },
    {
      "id": "e11",
      "source": "ctx",
      "target": "body",
      "sourceHandle": "user_email",
      "targetHandle": "editor_email"
    },
    {
      "id": "e12",
      "source": "url",
      "target": "patch",
      "sourceHandle": "value",
      "targetHandle": "url"
    },
    {
      "id": "e13",
      "source": "body",
      "target": "patch",
      "sourceHandle": "value",
      "targetHandle": "body"
    },
    {
      "id": "e14",
      "source": "input",
      "target": "patch",
      "sourceHandle": "image",
      "targetHandle": "files"
    },
    {
      "id": "e15",
      "source": "patch",
      "target": "output",
      "sourceHandle": "body",
      "targetHandle": "saga"
    }
  ]
}
