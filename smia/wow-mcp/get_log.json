{
  "version": 1,
  "nodes": [
    {
      "id": "input",
      "type": "tool.input",
      "fields": [
        {
          "name": "battletag",
          "type": "string",
          "required": false
        },
        {
          "name": "character_id",
          "type": "string",
          "required": false
        },
        {
          "name": "limit",
          "type": "number",
          "required": false,
          "description": "Default 50"
        }
      ]
    },
    {
      "id": "tag",
      "type": "util.convert",
      "config": {
        "toType": "string"
      }
    },
    {
      "id": "cid",
      "type": "util.convert",
      "config": {
        "toType": "string"
      }
    },
    {
      "id": "lim",
      "type": "util.convert",
      "config": {
        "toType": "string"
      }
    },
    {
      "id": "url",
      "type": "util.string.template",
      "config": {
        "template": "{{env.GUTSAGA_API_URL}}/v1/admin/log?battletag={{tag}}&character_id={{cid}}&limit={{lim}}"
      }
    },
    {
      "id": "get",
      "type": "http.request",
      "config": {
        "method": "GET",
        "headers": {
          "Authorization": "Bearer {{env.GUTSAGA_ADMIN_TOKEN}}"
        }
      }
    },
    {
      "id": "output",
      "type": "tool.output",
      "fields": [
        {
          "name": "result",
          "type": "object",
          "required": true
        }
      ]
    }
  ],
  "edges": [
    {
      "id": "e1",
      "source": "input",
      "target": "tag",
      "sourceHandle": "battletag",
      "targetHandle": "value"
    },
    {
      "id": "e2",
      "source": "input",
      "target": "cid",
      "sourceHandle": "character_id",
      "targetHandle": "value"
    },
    {
      "id": "e3",
      "source": "input",
      "target": "lim",
      "sourceHandle": "limit",
      "targetHandle": "value"
    },
    {
      "id": "e4",
      "source": "tag",
      "target": "url",
      "sourceHandle": "out",
      "targetHandle": "tag"
    },
    {
      "id": "e5",
      "source": "cid",
      "target": "url",
      "sourceHandle": "out",
      "targetHandle": "cid"
    },
    {
      "id": "e6",
      "source": "lim",
      "target": "url",
      "sourceHandle": "out",
      "targetHandle": "lim"
    },
    {
      "id": "e7",
      "source": "url",
      "target": "get",
      "sourceHandle": "value",
      "targetHandle": "url"
    },
    {
      "id": "e8",
      "source": "get",
      "target": "output",
      "sourceHandle": "body",
      "targetHandle": "result"
    }
  ]
}
