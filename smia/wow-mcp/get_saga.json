{
  "version": 1,
  "nodes": [
    {
      "id": "input",
      "type": "tool.input",
      "fields": [
        {
          "name": "saga_id",
          "type": "string",
          "required": true,
          "description": "GutSaga saga UUID from list_sagas / create_saga."
        }
      ]
    },
    {
      "id": "url",
      "type": "util.string.template",
      "config": {
        "template": "{{env.GUTSAGA_API_URL}}/v1/admin/sagas/{{id}}"
      }
    },
    {
      "id": "get",
      "type": "http.request",
      "config": {
        "method": "GET",
        "headers": {
          "Authorization": "Bearer {{env.GUTSAGA_ADMIN_TOKEN}}"
        }
      }
    },
    {
      "id": "title",
      "type": "util.get_path",
      "config": {
        "path": "title"
      }
    },
    {
      "id": "desc",
      "type": "util.get_path",
      "config": {
        "path": "description"
      }
    },
    {
      "id": "goals_md",
      "type": "util.get_path",
      "config": {
        "path": "goals_markdown"
      }
    },
    {
      "id": "has_image",
      "type": "util.get_path",
      "config": {
        "path": "has_image"
      }
    },
    {
      "id": "signed_url",
      "type": "util.get_path",
      "config": {
        "path": "image_signed_url"
      }
    },
    {
      "id": "card_cols",
      "type": "util.get_path",
      "config": {
        "path": "card.columns"
      }
    },
    {
      "id": "card_rows",
      "type": "util.get_path",
      "config": {
        "path": "card.rows"
      }
    },
    {
      "id": "empty_url",
      "type": "util.string.template",
      "config": {
        "template": "{{env.GUTSAGA_API_URL}}/v1/public/placeholder.png"
      }
    },
    {
      "id": "true_flag",
      "type": "util.constant",
      "config": {
        "valueType": "boolean",
        "value": true
      }
    },
    {
      "id": "has_cover",
      "type": "logic.compare",
      "config": {
        "op": "eq"
      }
    },
    {
      "id": "pick_url",
      "type": "logic.switch",
      "config": {
        "valueType": "string"
      }
    },
    {
      "id": "signed_s",
      "type": "util.convert",
      "config": {
        "toType": "string"
      }
    },
    {
      "id": "fetch",
      "type": "file.fetch"
    },
    {
      "id": "heading_desc",
      "type": "util.constant",
      "config": {
        "valueType": "json",
        "value": {
          "type": "heading",
          "text": "Beskrivelse"
        }
      }
    },
    {
      "id": "spacer",
      "type": "util.constant",
      "config": {
        "valueType": "json",
        "value": {
          "type": "divider"
        }
      }
    },
    {
      "id": "goals_fallback",
      "type": "util.constant",
      "config": {
        "valueType": "string",
        "value": "(ingen mål)"
      }
    },
    {
      "id": "goals_s",
      "type": "util.convert",
      "config": {
        "toType": "string"
      }
    },
    {
      "id": "goals_empty",
      "type": "logic.compare",
      "config": {
        "op": "eq"
      }
    },
    {
      "id": "empty_str",
      "type": "util.constant",
      "config": {
        "valueType": "string",
        "value": ""
      }
    },
    {
      "id": "pick_goals",
      "type": "logic.switch",
      "config": {
        "valueType": "string"
      }
    },
    {
      "id": "desc_fallback",
      "type": "util.constant",
      "config": {
        "valueType": "string",
        "value": "(ingen beskrivelse)"
      }
    },
    {
      "id": "desc_s",
      "type": "util.convert",
      "config": {
        "toType": "string"
      }
    },
    {
      "id": "desc_empty",
      "type": "logic.compare",
      "config": {
        "op": "eq"
      }
    },
    {
      "id": "pick_desc",
      "type": "logic.switch",
      "config": {
        "valueType": "string"
      }
    },
    {
      "id": "goals_block",
      "type": "util.json.build",
      "config": {
        "template": "{\"type\":\"text\",\"body\":{{body}}}",
        "inputs": [
          "body"
        ]
      }
    },
    {
      "id": "desc_block",
      "type": "util.json.build",
      "config": {
        "template": "{\"type\":\"text\",\"body\":{{body}}}",
        "inputs": [
          "body"
        ]
      }
    },
    {
      "id": "media_block",
      "type": "util.json.build",
      "config": {
        "template": "{\"type\":\"media\",\"file\":{{file}}}",
        "inputs": [
          "file"
        ]
      }
    },
    {
      "id": "table_block",
      "type": "util.json.build",
      "config": {
        "template": "{\"type\":\"table\",\"columns\":{{columns}},\"rows\":{{rows}}}",
        "inputs": [
          "columns",
          "rows"
        ]
      }
    },
    {
      "id": "blocks1",
      "type": "array.append"
    },
    {
      "id": "blocks2",
      "type": "array.append"
    },
    {
      "id": "blocks3",
      "type": "array.append"
    },
    {
      "id": "blocks4",
      "type": "array.append"
    },
    {
      "id": "blocks5",
      "type": "array.append"
    },
    {
      "id": "blocks6",
      "type": "array.append"
    },
    {
      "id": "card",
      "type": "ui.render",
      "config": {
        "layout": "stack",
        "fullWidth": true,
        "allowRefresh": true
      }
    },
    {
      "id": "output",
      "type": "tool.output",
      "fields": [
        {
          "name": "card",
          "type": "object",
          "required": false,
          "description": "Stack card: goals, Beskrivelse, cover, collapsible Aktivitet table."
        },
        {
          "name": "saga",
          "type": "object",
          "required": true,
          "description": "Full saga with versions, completed_by, goals_markdown, and activity card."
        }
      ]
    }
