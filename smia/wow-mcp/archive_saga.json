{
  "version": 1,
  "nodes": [
    {
      "id": "input",
      "type": "tool.input",
      "fields": [
        {
          "name": "saga_id",
          "type": "string",
          "required": true,
          "description": "GutSaga saga UUID from list_sagas / get_saga. Retires the saga (active=false) so companions stop offering it. Does not delete history or completions."
        }
      ]
    },
    {
      "id": "url",
      "type": "util.string.template",
      "config": {
        "template": "{{env.GUTSAGA_API_URL}}/v1/admin/sagas/{{id}}"
      }
    },
    {
      "id": "body",
      "type": "util.constant",
      "config": {
        "value": {"active": false, "changes": ["Arkivert"]},
        "valueType": "json"
      }
    },
    {
      "id": "patch",
      "type": "http.request",
      "config": {
        "method": "PATCH",
        "headers": {
          "Content-Type": "application/json",
          "Authorization": "Bearer {{env.GUTSAGA_ADMIN_TOKEN}}"
        }
      }
    },
    {
      "id": "output",
      "type": "tool.output",
      "fields": [
        {
          "name": "saga",
          "type": "object",
          "required": true,
          "description": "Retired saga (active=false). Hidden from companion sync. Completions and adventure-log history stay."
        }
      ]
    }
  ],
  "edges": [
    {
      "id": "e1",
      "source": "input",
      "target": "url",
      "sourceHandle": "saga_id",
      "targetHandle": "id"
    },
    {
      "id": "e2",
      "source": "url",
      "target": "patch",
      "sourceHandle": "value",
      "targetHandle": "url"
    },
    {
      "id": "e3",
      "source": "body",
      "target": "patch",
      "sourceHandle": "value",
      "targetHandle": "body"
    },
    {
      "id": "e4",
      "source": "patch",
      "target": "output",
      "sourceHandle": "body",
      "targetHandle": "saga"
    }
  ]
}
