{
  "version": 1,
  "nodes": [
    {
      "id": "input",
      "type": "tool.input",
      "fields": [
        {
          "name": "character_id",
          "type": "string",
          "required": true,
          "description": "GutSaga character UUID from list_characters"
        }
      ]
    },
    {
      "id": "url",
      "type": "util.string.template",
      "config": {
        "template": "{{env.GUTSAGA_API_URL}}/v1/admin/characters/{{id}}"
      }
    },
    {
      "id": "get",
      "type": "http.request",
      "config": {
        "method": "GET",
        "headers": {
          "Authorization": "Bearer {{env.GUTSAGA_ADMIN_TOKEN}}"
        }
      }
    },
    {
      "id": "output",
      "type": "tool.output",
      "fields": [
        {
          "name": "character",
          "type": "object",
          "required": true
        }
      ]
    }
  ],
  "edges": [
    {
      "id": "e1",
      "source": "input",
      "target": "url",
      "sourceHandle": "character_id",
      "targetHandle": "id"
    },
    {
      "id": "e2",
      "source": "url",
      "target": "get",
      "sourceHandle": "value",
      "targetHandle": "url"
    },
    {
      "id": "e3",
      "source": "get",
      "target": "output",
      "sourceHandle": "body",
      "targetHandle": "character"
    }
  ]
}
