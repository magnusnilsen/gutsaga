{
  "version": 1,
  "nodes": [
    {
      "id": "input",
      "type": "tool.input",
      "fields": [
        {
          "name": "battletag",
          "type": "string",
          "required": false,
          "description": "Optional filter e.g. Magnus#2231. Omit to list everyone."
        }
      ]
    },
    {
      "id": "tag",
      "type": "util.convert",
      "config": {
        "toType": "string"
      }
    },
    {
      "id": "url",
      "type": "util.string.template",
      "config": {
        "template": "{{env.GUTSAGA_API_URL}}/v1/admin/characters?battletag={{tag}}"
      }
    },
    {
      "id": "get",
      "type": "http.request",
      "config": {
        "method": "GET",
        "headers": {
          "Authorization": "Bearer {{env.GUTSAGA_ADMIN_TOKEN}}"
        }
      }
    },
    {
      "id": "output",
      "type": "tool.output",
      "fields": [
        {
          "name": "result",
          "type": "object",
          "required": true,
          "description": "{ characters: [...] }"
        }
      ]
    }
  ],
  "edges": [
    {
      "id": "e1",
      "source": "input",
      "target": "tag",
      "sourceHandle": "battletag",
      "targetHandle": "value"
    },
    {
      "id": "e2",
      "source": "tag",
      "target": "url",
      "sourceHandle": "out",
      "targetHandle": "tag"
    },
    {
      "id": "e3",
      "source": "url",
      "target": "get",
      "sourceHandle": "value",
      "targetHandle": "url"
    },
    {
      "id": "e4",
      "source": "get",
      "target": "output",
      "sourceHandle": "body",
      "targetHandle": "result"
    }
  ]
}
