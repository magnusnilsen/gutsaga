{
  "version": 1,
  "nodes": [
    {
      "id": "input",
      "type": "tool.input",
      "fields": [
        {
          "name": "character_id",
          "type": "string",
          "required": true,
          "description": "GutSaga character UUID to delete. Confirm with the player first."
        }
      ]
    },
    {
      "id": "url",
      "type": "util.string.template",
      "config": {
        "template": "{{env.GUTSAGA_API_URL}}/v1/admin/characters/{{id}}"
      }
    },
    {
      "id": "del",
      "type": "http.request",
      "config": {
        "method": "DELETE",
        "headers": {
          "Authorization": "Bearer {{env.GUTSAGA_ADMIN_TOKEN}}"
        }
      }
    },
    {
      "id": "ok",
      "type": "util.json.build",
      "config": {
        "inputs": [
          "status"
        ],
        "template": "{\"deleted\": true, \"status\": {{status}}}"
      }
    },
    {
      "id": "output",
      "type": "tool.output",
      "fields": [
        {
          "name": "result",
          "type": "object",
          "required": true
        }
      ]
    }
  ],
  "edges": [
    {
      "id": "e1",
      "source": "input",
      "target": "url",
      "sourceHandle": "character_id",
      "targetHandle": "id"
    },
    {
      "id": "e2",
      "source": "url",
      "target": "del",
      "sourceHandle": "value",
      "targetHandle": "url"
    },
    {
      "id": "e3",
      "source": "del",
      "target": "ok",
      "sourceHandle": "status",
      "targetHandle": "status"
    },
    {
      "id": "e4",
      "source": "ok",
      "target": "output",
      "sourceHandle": "value",
      "targetHandle": "result"
    }
  ]
}
