{
  "version": 1,
  "nodes": [
    {
      "id": "input",
      "type": "tool.input",
      "fields": [
        {
          "name": "quest_id",
          "type": "string",
          "required": true,
          "description": "GutSaga quest UUID from list_quests / create_quest."
        }
      ]
    },
    {
      "id": "url",
      "type": "util.string.template",
      "config": {
        "template": "{{env.GUTSAGA_API_URL}}/v1/admin/quests/{{id}}"
      }
    },
    {
      "id": "get",
      "type": "http.request",
      "config": {
        "method": "GET",
        "headers": {
          "Authorization": "Bearer {{env.GUTSAGA_ADMIN_TOKEN}}"
        }
      }
    },
    {
      "id": "title",
      "type": "util.get_path",
      "config": { "path": "title" }
    },
    {
      "id": "desc",
      "type": "util.get_path",
      "config": { "path": "description" }
    },
    {
      "id": "has_image",
      "type": "util.get_path",
      "config": { "path": "has_image" }
    },
    {
      "id": "signed_url",
      "type": "util.get_path",
      "config": { "path": "image_signed_url" }
    },
    {
      "id": "empty_url",
      "type": "util.string.template",
      "config": {
        "template": "{{env.GUTSAGA_API_URL}}/v1/public/placeholder.png"
      }
    },
    {
      "id": "true_flag",
      "type": "util.constant",
      "config": { "valueType": "boolean", "value": true }
    },
    {
      "id": "has_cover",
      "type": "logic.compare",
      "config": { "op": "eq" }
    },
    {
      "id": "pick_url",
      "type": "logic.switch",
      "config": { "valueType": "string" }
    },
    {
      "id": "signed_s",
      "type": "util.convert",
      "config": { "toType": "string" }
    },
    {
      "id": "fetch",
      "type": "file.fetch"
    },
    {
      "id": "card",
      "type": "ui.render",
      "config": { "layout": "media", "fullWidth": true }
    },
    {
      "id": "output",
      "type": "tool.output",
      "fields": [
        {
          "name": "quest",
          "type": "object",
          "required": true,
          "description": "Full saga (includes versions[]). has_image / image_signed_url when a cover exists."
        },
        {
          "name": "view",
          "type": "object",
          "required": false,
          "description": "Smia media card for the cover (or a full-width placeholder panel when the saga has no image)."
        }
      ]
    }
  ],
  "edges": [
    { "id": "e1", "source": "input", "target": "url", "sourceHandle": "quest_id", "targetHandle": "id" },
    { "id": "e2", "source": "url", "target": "get", "sourceHandle": "value", "targetHandle": "url" },
    { "id": "e3", "source": "get", "target": "title", "sourceHandle": "body", "targetHandle": "in" },
    { "id": "e4", "source": "get", "target": "desc", "sourceHandle": "body", "targetHandle": "in" },
    { "id": "e5", "source": "get", "target": "has_image", "sourceHandle": "body", "targetHandle": "in" },
    { "id": "e6", "source": "get", "target": "signed_url", "sourceHandle": "body", "targetHandle": "in" },
    { "id": "e7", "source": "has_image", "target": "has_cover", "sourceHandle": "value", "targetHandle": "a" },
    { "id": "e8", "source": "true_flag", "target": "has_cover", "sourceHandle": "value", "targetHandle": "b" },
    { "id": "e9", "source": "signed_url", "target": "signed_s", "sourceHandle": "value", "targetHandle": "value" },
    { "id": "e10", "source": "has_cover", "target": "pick_url", "sourceHandle": "result", "targetHandle": "switch" },
    { "id": "e11", "source": "signed_s", "target": "pick_url", "sourceHandle": "out", "targetHandle": "true" },
    { "id": "e12", "source": "empty_url", "target": "pick_url", "sourceHandle": "value", "targetHandle": "false" },
    { "id": "e13", "source": "pick_url", "target": "fetch", "sourceHandle": "result", "targetHandle": "url" },
    { "id": "e14", "source": "title", "target": "card", "sourceHandle": "value", "targetHandle": "title" },
    { "id": "e15", "source": "desc", "target": "card", "sourceHandle": "value", "targetHandle": "subtitle" },
    { "id": "e16", "source": "fetch", "target": "card", "sourceHandle": "file", "targetHandle": "file" },
    { "id": "e17", "source": "get", "target": "output", "sourceHandle": "body", "targetHandle": "quest" },
    { "id": "e18", "source": "card", "target": "output", "sourceHandle": "view", "targetHandle": "view" }
  ]
}
