{
  "version": 1,
  "nodes": [
    {
      "id": "input",
      "type": "tool.input",
      "fields": [
        {
          "name": "character_id",
          "type": "string",
          "required": true
        },
        {
          "name": "level",
          "type": "number",
          "required": true,
          "description": "New level (1-60 for Classic Era)"
        }
      ]
    },
    {
      "id": "url",
      "type": "util.string.template",
      "config": {
        "template": "{{env.GUTSAGA_API_URL}}/v1/admin/characters/{{id}}"
      }
    },
    {
      "id": "body",
      "type": "util.json.build",
      "config": {
        "inputs": [
          "level"
        ],
        "template": "{\"level\": {{level}}}"
      }
    },
    {
      "id": "patch",
      "type": "http.request",
      "config": {
        "method": "PATCH",
        "headers": {
          "Content-Type": "application/json",
          "Authorization": "Bearer {{env.GUTSAGA_ADMIN_TOKEN}}"
        }
      }
    },
    {
      "id": "output",
      "type": "tool.output",
      "fields": [
        {
          "name": "character",
          "type": "object",
          "required": true
        }
      ]
    }
  ],
  "edges": [
    {
      "id": "e1",
      "source": "input",
      "target": "url",
      "sourceHandle": "character_id",
      "targetHandle": "id"
    },
    {
      "id": "e2",
      "source": "input",
      "target": "body",
      "sourceHandle": "level",
      "targetHandle": "level"
    },
    {
      "id": "e3",
      "source": "url",
      "target": "patch",
      "sourceHandle": "value",
      "targetHandle": "url"
    },
    {
      "id": "e4",
      "source": "body",
      "target": "patch",
      "sourceHandle": "value",
      "targetHandle": "body"
    },
    {
      "id": "e5",
      "source": "patch",
      "target": "output",
      "sourceHandle": "body",
      "targetHandle": "character"
    }
  ]
}
