{
  "version": 1,
  "nodes": [
    {
      "id": "input",
      "type": "tool.input",
      "fields": [
        {
          "name": "os",
          "type": "string",
          "required": true,
          "enum": ["macos", "windows"],
          "description": "Pass exactly macos or windows. Map the player's machine first: Mac, MacBook, macOS, or darwin → macos. Windows or PC → windows."
        },
        {
          "name": "arch",
          "type": "string",
          "required": true,
          "enum": ["arm64", "amd64"],
          "description": "Pass exactly arm64 or amd64. Apple silicon (M1/M2/M3/M4) → arm64. Intel Mac → amd64. Windows → amd64, including Windows on ARM (there is no Windows ARM build)."
        }
      ]
    },
    {
      "id": "api_url",
      "type": "util.string.template",
      "config": {
        "template": "https://api.github.com/repos/magnusnilsen/gutsaga/releases/latest"
      }
    },
    {
      "id": "get",
      "type": "http.request",
      "config": {
        "method": "GET",
        "headers": {
          "Accept": "application/vnd.github+json",
          "User-Agent": "GutSaga"
        }
      }
    },
    {
      "id": "tag",
      "type": "util.get_path",
      "config": { "path": "tag_name" }
    },
    {
      "id": "lit_windows",
      "type": "util.constant",
      "config": { "valueType": "string", "value": "windows" }
    },
    {
      "id": "lit_windows_cap",
      "type": "util.constant",
      "config": { "valueType": "string", "value": "Windows" }
    },
    {
      "id": "lit_darwin",
      "type": "util.constant",
      "config": { "valueType": "string", "value": "darwin" }
    },
    {
      "id": "lit_arm",
      "type": "util.constant",
      "config": { "valueType": "string", "value": "arm64" }
    },
    {
      "id": "lit_aarch",
      "type": "util.constant",
      "config": { "valueType": "string", "value": "aarch64" }
    },
    {
      "id": "lit_amd",
      "type": "util.constant",
      "config": { "valueType": "string", "value": "amd64" }
    },
    {
      "id": "lit_exe",
      "type": "util.constant",
      "config": { "valueType": "string", "value": ".exe" }
    },
    {
      "id": "lit_empty",
      "type": "util.constant",
      "config": { "valueType": "string", "value": "" }
    },
    {
      "id": "true_b",
      "type": "util.constant",
      "config": { "valueType": "boolean", "value": true }
    },
    {
      "id": "false_b",
      "type": "util.constant",
      "config": { "valueType": "boolean", "value": false }
    },
    {
      "id": "cmp_win",
      "type": "logic.compare",
      "config": { "op": "eq" }
    },
    {
      "id": "cmp_win_cap",
      "type": "logic.compare",
      "config": { "op": "eq" }
    },
    {
      "id": "win_cap_b",
      "type": "logic.switch",
      "config": { "valueType": "boolean" }
    },
    {
      "id": "is_win",
      "type": "logic.switch",
      "config": { "valueType": "boolean" }
    },
    {
      "id": "cmp_arm",
      "type": "logic.compare",
      "config": { "op": "eq" }
    },
    {
      "id": "cmp_aarch",
      "type": "logic.compare",
      "config": { "op": "eq" }
    },
    {
      "id": "aarch_b",
      "type": "logic.switch",
      "config": { "valueType": "boolean" }
    },
    {
      "id": "is_arm",
      "type": "logic.switch",
      "config": { "valueType": "boolean" }
    },
    {
      "id": "arch_from_aarch",
      "type": "logic.switch",
      "config": { "valueType": "string" }
    },
    {
      "id": "arch_mac",
      "type": "logic.switch",
      "config": { "valueType": "string" }
    },
    {
      "id": "os_token",
      "type": "logic.switch",
      "config": { "valueType": "string" }
    },
    {
      "id": "arch_token",
      "type": "logic.switch",
      "config": { "valueType": "string" }
    },
    {
      "id": "ext",
      "type": "logic.switch",
      "config": { "valueType": "string" }
    },
    {
      "id": "filename",
      "type": "util.string.template",
      "config": { "template": "gutsaga-{{platform}}-{{cpu}}{{suffix}}" }
    },
    {
      "id": "dl_prefix",
      "type": "util.constant",
      "config": {
        "valueType": "string",
        "value": "https://github.com/magnusnilsen/gutsaga/releases/latest/download/"
      }
    },
    {
      "id": "download",
      "type": "util.string.template",
      "config": { "template": "{{prefix}}{{name}}" }
    },
    {
      "id": "checksums",
      "type": "util.constant",
      "config": {
        "valueType": "string",
        "value": "https://github.com/magnusnilsen/gutsaga/releases/latest/download/SHA256SUMS"
      }
    },
    {
      "id": "addon",
      "type": "util.constant",
      "config": {
        "valueType": "string",
        "value": "https://github.com/magnusnilsen/gutsaga/releases/latest/download/GutSaga-addon.zip"
      }
    },
    {
      "id": "releases",
      "type": "util.constant",
      "config": {
        "valueType": "string",
        "value": "https://github.com/magnusnilsen/gutsaga/releases/latest"
      }
    },
    {
      "id": "gate_mac",
      "type": "util.constant",
      "config": {
        "valueType": "string",
        "value": "The file is unsigned. On macOS, chmod +x the file, then System Settings → Privacy & Security → Open Anyway. If it is still blocked, xattr -cr the file and start it from Terminal once."
      }
    },
    {
      "id": "gate_win",
      "type": "util.constant",
      "config": {
        "valueType": "string",
        "value": "The file is unsigned. Windows SmartScreen says the PC was protected. Choose More info, then Run anyway."
      }
    },
    {
      "id": "first_run",
      "type": "logic.switch",
      "config": { "valueType": "string" }
    },
    {
      "id": "run_txt",
      "type": "util.constant",
      "config": {
        "valueType": "string",
        "value": "Run the file. It installs the GutSaga addon into Interface/AddOns and opens Smia login. No API key."
      }
    },
    {
      "id": "game_txt",
      "type": "util.constant",
      "config": {
        "valueType": "string",
        "value": "At character select, enable GutSaga, then /reload or log in again. /gutsaga or /gs opens the adventure log. The minimap has a G button."
      }
    },
    {
      "id": "update_txt",
      "type": "util.constant",
      "config": {
        "valueType": "string",
        "value": "Update checks are on by default. A newer build downloads in the background. The tray item is Norwegian even in other languages: Ny versjon vX.Y.Z — start på nytt. Choosing it applies the update. The app does not restart itself. The same menu turns automatic updates off. --no-update skips one launch."
      }
    },
    {
      "id": "note_arm",
      "type": "util.constant",
      "config": {
        "valueType": "string",
        "value": "There is no Windows ARM build. This link is the amd64 exe. Windows on ARM runs it under emulation."
      }
    },
    {
      "id": "note_if_arm",
      "type": "logic.switch",
      "config": { "valueType": "string" }
    },
    {
      "id": "note",
      "type": "logic.switch",
      "config": { "valueType": "string" }
    },
    {
      "id": "output",
      "type": "tool.output",
      "fields": [
        {
          "name": "version",
          "type": "string",
          "required": false,
          "description": "Latest release tag, such as v0.1.0. Empty until the first GitHub release exists."
        },
        {
          "name": "os",
          "type": "string",
          "required": true,
          "description": "The os argument the caller passed."
        },
        {
          "name": "arch",
          "type": "string",
          "required": true,
          "description": "The arch argument the caller passed."
        },
        {
          "name": "filename",
          "type": "string",
          "required": true,
          "description": "Asset name for this machine. Windows on ARM still gets the amd64 exe."
        },
        {
          "name": "download_url",
          "type": "string",
          "required": true,
          "description": "Direct download for this machine. Give the user this link, not the other platforms."
        },
        {
          "name": "checksums_url",
          "type": "string",
          "required": true,
          "description": "SHA256SUMS for the release."
        },
        {
          "name": "addon_zip_url",
          "type": "string",
          "required": true,
          "description": "Fallback only. The companion installs the addon itself."
        },
        {
          "name": "release_url",
          "type": "string",
          "required": true,
          "description": "Latest release page."
        },
        {
          "name": "first_run",
          "type": "string",
          "required": true,
          "description": "Unsigned-binary step for this os. Rewrite in the user's language. Keep chmod and xattr as-is."
        },
        {
          "name": "run",
          "type": "string",
          "required": true,
          "description": "What happens when they start the file. Rewrite in the user's language."
        },
        {
          "name": "in_game",
          "type": "string",
          "required": true,
          "description": "Addon enable and slash commands. Rewrite around the commands; keep /reload, /gutsaga, and /gs."
        },
        {
          "name": "auto_update",
          "type": "string",
          "required": true,
          "description": "Update behavior. Rewrite in the user's language. Keep the Norwegian tray label as written."
        },
        {
          "name": "note",
          "type": "string",
          "required": false,
          "description": "Extra fact for this machine. Empty when there is nothing to add. Rewrite in the user's language when it is set."
        }
      ]
    }
  ],
  "edges": [
    {"id": "e1", "source": "api_url", "target": "get", "sourceHandle": "value", "targetHandle": "url"},
    {"id": "e2", "source": "get", "target": "tag", "sourceHandle": "body", "targetHandle": "in"},
