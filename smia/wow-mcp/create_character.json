{
  "version": 1,
  "nodes": [
    {
      "id": "input",
      "type": "tool.input",
      "fields": [
        {
          "name": "battletag",
          "type": "string",
          "required": true,
          "description": "Player BattleTag e.g. Magnus#2231"
        },
        {
          "name": "name",
          "type": "string",
          "required": true,
          "description": "In-game character name"
        },
        {
          "name": "realm",
          "type": "string",
          "required": true,
          "description": "Realm as reported by the client (e.g. Celebras)"
        },
        {
          "name": "race",
          "type": "string",
          "required": false
        },
        {
          "name": "class",
          "type": "string",
          "required": false
        },
        {
          "name": "level",
          "type": "number",
          "required": false,
          "description": "Defaults to 1"
        },
        {
          "name": "backstory",
          "type": "string",
          "required": false,
          "description": "Full RP backstory text"
        }
      ]
    },
    {
      "id": "body",
      "type": "util.json.build",
      "config": {
        "inputs": ["battletag", "name", "realm", "race", "class", "level", "backstory"],
        "template": "{\"battletag\": {{battletag}}, \"name\": {{name}}, \"realm\": {{realm}}, \"race\": {{race}}, \"class\": {{class}}, \"level\": {{level}}, \"backstory\": {{backstory}}}"
      }
    },
    {
      "id": "post",
      "type": "http.request",
      "config": {
        "url": "{{env.GUTSAGA_API_URL}}/v1/admin/characters",
        "method": "POST",
        "headers": {
          "Content-Type": "application/json",
          "Authorization": "Bearer {{env.GUTSAGA_ADMIN_TOKEN}}"
        }
      }
    },
    {
      "id": "output",
      "type": "tool.output",
      "fields": [
        {
          "name": "character",
          "type": "object",
          "required": true
        }
      ]
    }
  ],
  "edges": [
    { "id": "e1", "source": "input", "target": "body", "sourceHandle": "battletag", "targetHandle": "battletag" },
    { "id": "e2", "source": "input", "target": "body", "sourceHandle": "name", "targetHandle": "name" },
    { "id": "e3", "source": "input", "target": "body", "sourceHandle": "realm", "targetHandle": "realm" },
    { "id": "e4", "source": "input", "target": "body", "sourceHandle": "race", "targetHandle": "race" },
    { "id": "e5", "source": "input", "target": "body", "sourceHandle": "class", "targetHandle": "class" },
    { "id": "e6", "source": "input", "target": "body", "sourceHandle": "level", "targetHandle": "level" },
    { "id": "e7", "source": "input", "target": "body", "sourceHandle": "backstory", "targetHandle": "backstory" },
    { "id": "e8", "source": "body", "target": "post", "sourceHandle": "value", "targetHandle": "body" },
    { "id": "e9", "source": "post", "target": "output", "sourceHandle": "body", "targetHandle": "character" }
  ]
}
