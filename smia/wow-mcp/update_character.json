{
  "version": 1,
  "nodes": [
    {
      "id": "input",
      "type": "tool.input",
      "fields": [
        {
          "name": "character_id",
          "type": "string",
          "required": true
        },
        {
          "name": "name",
          "type": "string",
          "required": false
        },
        {
          "name": "realm",
          "type": "string",
          "required": false
        },
        {
          "name": "race",
          "type": "string",
          "required": false
        },
        {
          "name": "class",
          "type": "string",
          "required": false
        },
        {
          "name": "level",
          "type": "number",
          "required": false
        },
        {
          "name": "backstory",
          "type": "string",
          "required": false,
          "description": "Full backstory replacement when provided"
        }
      ]
    },
    {
      "id": "url",
      "type": "util.string.template",
      "config": {
        "template": "{{env.GUTSAGA_API_URL}}/v1/admin/characters/{{id}}"
      }
    },
    {
      "id": "body",
      "type": "util.json.build",
      "config": {
        "inputs": [
          "name",
          "realm",
          "race",
          "class",
          "level",
          "backstory"
        ],
        "template": "{\"name\": {{name}}, \"realm\": {{realm}}, \"race\": {{race}}, \"class\": {{class}}, \"level\": {{level}}, \"backstory\": {{backstory}}}"
      }
    },
    {
      "id": "patch",
      "type": "http.request",
      "config": {
        "method": "PATCH",
        "headers": {
          "Content-Type": "application/json",
          "Authorization": "Bearer {{env.GUTSAGA_ADMIN_TOKEN}}"
        }
      }
    },
    {
      "id": "output",
      "type": "tool.output",
      "fields": [
        {
          "name": "character",
          "type": "object",
          "required": true
        }
      ]
    }
  ],
  "edges": [
    {
      "id": "e1",
      "source": "input",
      "target": "url",
      "sourceHandle": "character_id",
      "targetHandle": "id"
    },
    {
      "id": "e2",
      "source": "input",
      "target": "body",
      "sourceHandle": "name",
      "targetHandle": "name"
    },
    {
      "id": "e3",
      "source": "input",
      "target": "body",
      "sourceHandle": "realm",
      "targetHandle": "realm"
    },
    {
      "id": "e4",
      "source": "input",
      "target": "body",
      "sourceHandle": "race",
      "targetHandle": "race"
    },
    {
      "id": "e5",
      "source": "input",
      "target": "body",
      "sourceHandle": "class",
      "targetHandle": "class"
    },
    {
      "id": "e6",
      "source": "input",
      "target": "body",
      "sourceHandle": "level",
      "targetHandle": "level"
    },
    {
      "id": "e7",
      "source": "input",
      "target": "body",
      "sourceHandle": "backstory",
      "targetHandle": "backstory"
    },
    {
      "id": "e8",
      "source": "url",
      "target": "patch",
      "sourceHandle": "value",
      "targetHandle": "url"
    },
    {
      "id": "e9",
      "source": "body",
      "target": "patch",
      "sourceHandle": "value",
      "targetHandle": "body"
    },
    {
      "id": "e10",
      "source": "patch",
      "target": "output",
      "sourceHandle": "body",
      "targetHandle": "character"
    }
  ]
}
