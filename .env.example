# Copy to .env and fill in. docker compose reads this automatically.

# Optional: copied once onto the bootstrap group when its webhook is empty.
# Owners set per-group URLs with PUT /v1/groups/{id}/webhook. See docs/webhooks.md.
# SAGALORE_BOOTSTRAP_WEBHOOK_URL=https://example.com/hooks/sagalore

# Signed saga covers for chat clients (optional). Compose already sets local defaults.
# PUBLIC_BASE_URL=https://sagalore.example.com
# IMAGE_URL_SECRET=
# IMAGE_URL_TTL=1h
