# Copy to .env and fill in. docker compose reads this automatically.
# Discord: channel → Edit → Integrations → Webhooks → New → copy URL.
# Same URL for new sagas, edits, retirements, milestone levels, and completions.
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# Signed saga covers for chat clients (optional). Compose already sets local defaults.
# PUBLIC_BASE_URL=https://sagaboard.example.com
# IMAGE_URL_SECRET=
# IMAGE_URL_TTL=1h
